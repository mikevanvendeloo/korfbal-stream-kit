{
  "name": "@korfbal-stream-kit/korfbal-stream-apps",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve --all",
    "build": "nx run-many -t build --all",
    "test": "nx affected -t test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api:dev": "npm run prisma:generate && dotenv -e apps/korfbal-stream-api/.env -- nx dev @korfbal-stream-kit/korfbal-stream-api --verbose",
    "api:build": "nx build @korfbal-stream-kit/korfbal-stream-api",
    "api:package": "nx package @korfbal-stream-kit/korfbal-stream-api",
    "api:serve": "npm run prisma:generate && dotenv -e apps/korfbal-stream-api/.env -- nx serve @korfbal-stream-kit/korfbal-stream-api --verbose",
    "api:test": "nx test @korfbal-stream-kit/korfbal-stream-api",
    "api:test-no-db": "REQUIRE_DB=false nx test @korfbal-stream-kit/korfbal-stream-api",
    "api:test:integration": "dotenv -e apps/korfbal-stream-api/.env -- vitest run apps/korfbal-stream-api/src/routes/sponsors.int.spec.ts --environment=node",
    "kit:dev": "nx serve @korfbal-stream-kit/korfbal-stream-kit",
    "kit:build": "nx build @korfbal-stream-kit/korfbal-stream-kit",
    "kit:test": "nx test @korfbal-stream-kit/korfbal-stream-kit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:generate": "dotenv -e apps/korfbal-stream-api/.env -- prisma generate --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:format": "dotenv -e apps/korfbal-stream-api/.env -- prisma format --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate dev --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate deploy --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:seed": "dotenv -e apps/korfbal-stream-api/.env -- tsx apps/korfbal-stream-api/prisma/seed.ts",
    "seed:callsheet": "dotenv -e apps/korfbal-stream-api/.env -- tsx scripts/seed-callsheet.ts ",
    "prisma:studio": "dotenv -e apps/korfbal-stream-api/.env -- prisma studio --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "generate:sponsors:csv": "tsx ./scripts/generate-sponsor-csv.ts",
    "generate:release-notes": "tsx ./scripts/generate-release-notes.ts",
    "scripts:test": "vitest run scripts",
    "clean": "nx reset && rm -rf node_modules dist .nx/cache tmp",
    "reinstall": "npm run clean && npm i",
    "prisma:reset": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate reset --schema=apps/korfbal-stream-api/prisma/schema.prisma"
  },
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "baseline-browser-mapping": "^2.11.20",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.35.0",
    "multer": "^2.3.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.30.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@eslint/js": "^9.39.5",
    "@nx/devkit": "21.6.5",
    "@nx/docker": "21.6.5",
    "@nx/esbuild": "21.6.5",
    "@nx/eslint": "21.6.5",
    "@nx/eslint-plugin": "21.6.5",
    "@nx/express": "21.6.5",
    "@nx/jest": "21.6.5",
    "@nx/js": "21.6.5",
    "@nx/node": "21.6.5",
    "@nx/playwright": "21.6.5",
    "@nx/react": "21.6.5",
    "@nx/vite": "21.6.5",
    "@nx/web": "21.6.5",
    "@nx/webpack": "21.6.5",
    "@nx/workspace": "21.6.5",
    "@playwright/test": "^1.62.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.1.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "20.19.9",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "10.4.13",
    "dotenv-cli": "^10.0.0",
    "esbuild": "0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "^15.15.0",
    "jest": "^30.5.0",
    "jest-environment-node": "^30.5.0",
    "jest-util": "^30.5.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "21.6.5",
    "postcss": "8.4.38",
    "prettier": "^2.8.8",
    "react-refresh": "^0.10.0",
    "supertest": "^7.2.2",
    "tailwindcss": "3.4.3",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "uuid": "^13.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "webpack-cli": "^5.1.4"
  }
}
