{
  "name": "@korfbal-stream-kit/korfbal-stream-apps",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve --all",
    "build": "nx run-many -t build --all",
    "test": "nx affected -t test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "nx run-many -t typecheck",
    "api:dev": "npm run prisma:generate && dotenv -e apps/korfbal-stream-api/.env -- nx dev @korfbal-stream-kit/korfbal-stream-api --verbose",
    "api:build": "nx build @korfbal-stream-kit/korfbal-stream-api",
    "api:package": "nx package @korfbal-stream-kit/korfbal-stream-api",
    "api:serve": "npm run prisma:generate && dotenv -e apps/korfbal-stream-api/.env -- nx serve @korfbal-stream-kit/korfbal-stream-api --verbose",
    "api:test": "npm run api:test:integration",
    "api:test-no-db": "REQUIRE_DB=false nx test @korfbal-stream-kit/korfbal-stream-api",
    "e2e": "playwright test --config apps/korfbal-stream-kit-e2e/playwright.config.ts",
    "api:test:integration": "REQUIRE_DB=true vitest run --config apps/korfbal-stream-api/vitest.config.ts",
    "kit:dev": "nx serve @korfbal-stream-kit/korfbal-stream-kit",
    "kit:build": "nx build @korfbal-stream-kit/korfbal-stream-kit",
    "kit:test": "nx test @korfbal-stream-kit/korfbal-stream-kit",
    "bridge:dev": "nx dev @korfbal-stream-kit/venue-bridge",
    "bridge:build": "nx build @korfbal-stream-kit/venue-bridge",
    "bridge:test": "nx test @korfbal-stream-kit/venue-bridge",
    "db:up": "docker compose -f docker-compose-db.yml up -d",
    "db:down": "docker compose -f docker-compose-db.yml down",
    "db:restore-backup": "bash scripts/restore-backup.sh --target npm",
    "docker:restore-backup": "bash scripts/restore-backup.sh --target docker",
    "prisma:generate": "dotenv -e apps/korfbal-stream-api/.env -- prisma generate --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:format": "dotenv -e apps/korfbal-stream-api/.env -- prisma format --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate dev --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:deploy": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate deploy --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "prisma:seed": "dotenv -e apps/korfbal-stream-api/.env -- tsx apps/korfbal-stream-api/prisma/seed.ts",
    "seed:callsheet": "dotenv -e apps/korfbal-stream-api/.env -- tsx scripts/seed-callsheet.ts ",
    "prisma:studio": "dotenv -e apps/korfbal-stream-api/.env -- prisma studio --schema=apps/korfbal-stream-api/prisma/schema.prisma",
    "generate:sponsors:csv": "tsx ./scripts/generate-sponsor-csv.ts",
    "generate:release-notes": "tsx ./scripts/generate-release-notes.ts",
    "scripts:test": "vitest run scripts",
    "clean": "nx reset && rm -rf node_modules dist .nx/cache tmp",
    "reinstall": "npm run clean && npm i",
    "prisma:reset": "dotenv -e apps/korfbal-stream-api/.env -- prisma migrate reset --schema=apps/korfbal-stream-api/prisma/schema.prisma"
  },
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.21.1",
    "baseline-browser-mapping": "^2.11.35",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.71.0",
    "marked": "18.0.14",
    "mdb-reader": "^3.2.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.7.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^6.30.6",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@eslint/js": "^9.39.5",
    "@nx/devkit": "22.7.12",
    "@nx/docker": "22.7.12",
    "@nx/esbuild": "22.7.12",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/express": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/node": "22.7.12",
    "@nx/playwright": "22.7.12",
    "@nx/react": "22.7.12",
    "@nx/vite": "22.7.12",
    "@nx/vitest": "22.7.12",
    "@nx/web": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.1.0",
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "20.19.9",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "10.4.13",
    "dotenv-cli": "^10.0.0",
    "esbuild": "0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.8.3",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "^15.15.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.7.12",
    "postcss": "8.5.23",
    "prettier": "^2.8.8",
    "react-refresh": "^0.10.0",
    "supertest": "^7.3.2",
    "tailwindcss": "3.4.3",
    "testcontainers": "^11.14.0",
    "ts-node": "10.9.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "uuid": "^13.0.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
