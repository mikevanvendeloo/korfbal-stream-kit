# Kopieer naar secrets.prod.env (staat in .gitignore) naast docker-compose-prod.yml en vul in.
# Wordt via env_file doorgegeven aan de db-, migratie- en API-containers.

# Wachtwoord van de postgres-gebruiker 'fortuna'
POSTGRES_PASSWORD=
# Moet hetzelfde wachtwoord bevatten als POSTGRES_PASSWORD
DATABASE_URL=postgresql://fortuna:<wachtwoord>@streamz-db:5432/streamz?schema=public
# Bearer token voor de wedstrijdplanning-API
MATCH_SCHEDULE_API_TOKEN=
# IP van de host, voor automatische detectie van de vMix-endpoint
HOST_IP=
