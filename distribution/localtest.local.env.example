# Instellingen voor start-localtest.sh (Mac/Linux) en start-localtest.cmd (Windows), naast dit bestand.
# Relatieve paden gaan vanaf deze map (distribution/).
# Kopieer naar localtest.local.env (niet ingecheckt) en vul in. Geen commentaar achter een waarde op dezelfde regel.

# --- Streamz (docker-compose-localtest.yml) ---
# De pg_dump-backup waarmee de database bij de eerste start (of na --reset) wordt gevuld
LOCALTEST_SQL=../../2025-2026-backup/streamz-2025.sql
# De map met afbeeldingen (spelers, sponsors, clubs) op je eigen schijf
LOCALTEST_STORAGE=../storage
LOCALTEST_DB_PASSWORD=localtest
# true: ook elke geslaagde GET (vMix, scorebord) loggen
DEBUG_LOGGING=false

# --- Venue-bridge (gebouwd uit de lokale code, op hetzelfde netwerk als de API) ---
# De bridge-container leest API_URL, API_KEY, BRIDGE_NAME, BRIDGE_PAGE_URL en LOG_LEVEL rechtstreeks uit dit bestand
# (env_file in docker-compose.venue-bridge-dev.yml).
RUN_BRIDGE=true
# Een API-sleutel van de organisatie. Na de eerste start aanmaken in de Kit (http://localhost):
# Beheer > Organisatie-instellingen > API-sleutels, hier invullen en opnieuw starten met --only bridge.
API_KEY=
BRIDGE_NAME=localtest
# De API in localtest op hetzelfde Docker-netwerk (leeg geeft hetzelfde)
API_URL=http://korfbal-streamz-api:3333
BRIDGE_PAGE_URL=http://localhost:3340
# Bron van de statistieken. Leeg: de opgeslagen pagina local-html/ (geen statistiek-pc nodig;
# in de Kit bij Instellingen > Venue > Statistieken als pagina tweede-scherm.html invullen en "Database gebruiken" uit).
# Anders: mac, windows-robocopy, cifs of page-only (variants/).
BRIDGE_VARIANT=
# mac / windows-robocopy: de map met F1/, F2/ (leeg: /Volumes/KL2627 resp. C:/streamz/stats)
STATS_SOURCE_DIR=
# cifs: de share en (als gast niet mag) de inloggegevens
STATS_CIFS_DEVICE=
STATS_CIFS_OPTIONS=
# info, of debug voor elke stap bij het lezen van de statistieken
LOG_LEVEL=info
