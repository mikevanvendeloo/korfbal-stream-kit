# Kopieer naar secrets.env (staat in .gitignore) en vul de waarden in.
# docker-compose.yml geeft dit bestand via env_file door aan de API-container.
# Bewust geen .env/.env.local: Nx laadt die automatisch in elke task (api:dev, tests, ...).

# Bearer token voor de wedstrijdplanning-API (sportclubvrijwilligersmanagement.nl)
MATCH_SCHEDULE_API_TOKEN=
