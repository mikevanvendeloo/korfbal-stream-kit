{
  "title": "Korfbal Stream – Overview",
  "uid": "korfbal-overview",
  "tags": ["korfbal", "stream"],
  "timezone": "Europe/Amsterdam",
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "title": "Container Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{container_name!=\"\"} / 1024 / 1024",
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "thresholds": { "steps": [
        { "value": 0, "color": "green" },
        { "value": 80, "color": "orange" },
        { "value": 95, "color": "red" }
      ] } } }
    },
    {
      "title": "Container CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{container_name!=\"\"}[1m])",
          "legendFormat": "{{container_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"streamz\"}",
          "legendFormat": "Active connections"
        }
      ]
    },
    {
      "title": "PostgreSQL Transactions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"streamz\"}[1m])",
          "legendFormat": "Commits"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"streamz\"}[1m])",
          "legendFormat": "Rollbacks"
        }
      ]
    },
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(http_requests_total{service=\"korfbal-streamz-api\"}[1m])",
          "legendFormat": "{{method}} {{code}}"
        }
      ]
    },
    {
      "title": "API P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"korfbal-streamz-api\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}