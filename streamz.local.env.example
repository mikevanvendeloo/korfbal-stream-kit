# Instellingen voor scripts\streamz\start.cmd en upgrade.cmd (Windows).
# Kopieer naar streamz.local.env (niet ingecheckt) en vul in. upgrade.cmd schrijft de versies hieronder bij.
# Let op: start Streamz voortaan met start.cmd (of docker compose --env-file streamz.local.env ...); een kale
# 'docker compose -f docker-compose-prod.yml up -d' neemt de standaardversies uit het compose-bestand.

# Wat draait er op deze pc? (true/false)
RUN_STREAMZ=true
RUN_BRIDGE=true

# Versies (release-tags van Docker Hub, bijv. 2026.11.2). Leeg: de standaard uit het compose-bestand.
STREAMZ_API_VERSION=
STREAMZ_KIT_VERSION=
STREAMZ_BRIDGE_VERSION=

# Venue-bridge
# Variant voor de statistieken: windows-robocopy, cifs, page-only of mac (zie apps/venue-bridge/compose/variants)
BRIDGE_VARIANT=windows-robocopy
# Het adres van Streamz. Draait de API op deze pc: http://host.docker.internal:3333
API_URL=http://host.docker.internal:3333
# Een API-sleutel van de organisatie (Beheer > Instellingen)
API_KEY=
BRIDGE_NAME=Zaal Fortuna
# Optioneel: het adres van de pagina van de bridge op het netwerk van de zaal, bijv. http://192.168.1.10:3340
BRIDGE_PAGE_URL=
# windows-robocopy: de lokale map die sync-stats.ps1 vult
STATS_SOURCE_DIR=C:/streamz/stats
# LOG_LEVEL=debug
