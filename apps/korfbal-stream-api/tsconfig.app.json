{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/korfbal-stream-api",
    "module": "es2020",
    "target": "es2020",
    "moduleResolution": "bundler",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "../../libs/**/*.spec.ts",
    "src/test-setup.ts",
    "src/test-global-setup.ts",
    "src/test-database.ts"
  ],
  "references": [
    {
      "path": "../../libs/venue-protocol/tsconfig.lib.json"
    }
  ]
}
