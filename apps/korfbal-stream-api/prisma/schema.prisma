generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sponsor {
  id             Int          @id @default(autoincrement())
  name           String
  type           SponsorType
  logoUrl        String
  websiteUrl     String
  createdAt      DateTime     @default(now())
  categories     String?
  displayName    String?
  enabled        Boolean      @default(true)
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Season {
  id        Int             @id @default(autoincrement())
  startYear Int             @unique
  name      String          @unique
  createdAt DateTime        @default(now())
  matches   MatchSchedule[]
  players   Player[]
}

model MatchSchedule {
  id                 Int                   @id @default(autoincrement())
  externalId         String?
  date               DateTime
  homeTeamName       String
  awayTeamName       String
  accommodationName  String?
  accommodationRoute String?
  attendanceTime     DateTime?
  isPracticeMatch    Boolean               @default(false)
  isHomeMatch        Boolean               @default(false)
  isCompetitiveMatch Boolean               @default(false)
  fieldName          String?
  refereeName        String?
  reserveRefereeName String?
  homeScore          Int?
  awayScore          Int?
  color              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  description        String?
  isManual           Boolean               @default(false)
  seasonId           Int
  season             Season                @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  roleAssignments    MatchRoleAssignment[]
  Production         Production?
  organizationId     Int                   @default(dbgenerated("missing_organization_id()"))
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([date])
  @@index([seasonId, date])
  @@index([organizationId])
}

/// Catalog of skills (roles) with code and gendered display names
model Skill {
  id             Int                   @id @default(autoincrement())
  code           String
  nameMale       String
  nameFemale     String
  createdAt      DateTime              @default(now())
  name           String
  type           SkillType             @default(crew)
  assignments    MatchRoleAssignment[]
  skills         PersonSkill[]
  Position       Position[]
  organizationId Int                   @default(dbgenerated("missing_organization_id()"))
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("Capability")
}

/// Catalog of production positions (distinct from skills)
model Position {
  id                     Int                         @id @default(autoincrement())
  name                   String
  createdAt              DateTime                    @default(now())
  /// Optional link to a skill that is required for this position
  skillId                Int?
  /// Indicates if this is a studio position (true) or production position (false)
  isStudio               Boolean                     @default(false)
  category               PositionCategory            @default(GENERAL)
  sortOrder              Int                         @default(99)
  callSheetItemPositions CallSheetItemPosition[]
  templatePositions      CallSheetTemplatePosition[]
  skill                  Skill?                      @relation(fields: [skillId], references: [id])
  linkedPositions        PositionLink[]              @relation("SourcePosition")
  linkedToPositions      PositionLink[]              @relation("TargetPosition")
  productionEvents       ProductionEventPosition[]
  productionPositions    ProductionPersonPosition[]
  SegmentDefaultPosition SegmentDefaultPosition[]
  segmentAssignments     SegmentRoleAssignment[]
  organizationId         Int                         @default(dbgenerated("missing_organization_id()"))
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// NIEUW: Koppeling tussen posities voor synchronisatie van de callsheet
model PositionLink {
  id               Int          @id @default(autoincrement())
  sourcePositionId Int
  targetPositionId Int
  sourcePosition   Position     @relation("SourcePosition", fields: [sourcePositionId], references: [id], onDelete: Cascade)
  targetPosition   Position     @relation("TargetPosition", fields: [targetPositionId], references: [id], onDelete: Cascade)
  organizationId   Int          @default(dbgenerated("missing_organization_id()"))
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([sourcePositionId, targetPositionId])
  @@index([organizationId])
}

/// People who can be assigned roles in livestream productions
model Person {
  id                  Int                        @id @default(autoincrement())
  name                String
  gender              Gender
  createdAt           DateTime                   @default(now())
  assignments         MatchRoleAssignment[]
  skills              PersonSkill[]
  productionPresences ProductionPerson[]
  productionPositions ProductionPersonPosition[]
  segmentAssignments  SegmentRoleAssignment[]
  organizationId      Int                        @default(dbgenerated("missing_organization_id()"))
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Link table: which skills a person has
model PersonSkill {
  personId       Int
  createdAt      DateTime     @default(now())
  skillId        Int
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill          Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([personId, skillId])
  @@index([organizationId])
  @@map("PersonCapability")
}

/// Assignment of a person to a role for a specific match
model MatchRoleAssignment {
  id              Int           @id @default(autoincrement())
  matchScheduleId Int
  personId        Int
  createdAt       DateTime      @default(now())
  skillId         Int
  matchSchedule   MatchSchedule @relation(fields: [matchScheduleId], references: [id], onDelete: Cascade)
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  organizationId  Int           @default(dbgenerated("missing_organization_id()"))
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([matchScheduleId, skillId, personId])
  @@unique([matchScheduleId, skillId, personId], map: "MatchRoleAssignment_matchScheduleId_capabilityId_personId_key")
  @@index([matchScheduleId])
  @@index([personId])
  @@index([skillId])
  @@index([organizationId])
}

/// A production instance for a given match
model Production {
  id                  Int                        @id @default(autoincrement())
  matchScheduleId     Int                        @unique
  createdAt           DateTime                   @default(now())
  isActive            Boolean                    @default(false)
  liveTime            DateTime?
  callSheetTemplateId Int?
  callSheets          CallSheet[]
  interviewSubjects   InterviewSubject[]
  callSheetTemplate   CallSheetTemplate?         @relation(fields: [callSheetTemplateId], references: [id])
  matchSchedule       MatchSchedule              @relation(fields: [matchScheduleId], references: [id], onDelete: Cascade)
  productionEvents    ProductionEvent[]
  productionPersons   ProductionPerson[]
  productionPositions ProductionPersonPosition[]
  productionReport    ProductionReport?
  segments            ProductionSegment[]
  TitleDefinition     TitleDefinition[]
  organizationId      Int                        @default(dbgenerated("missing_organization_id()"))
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CallSheetTemplate {
  id             Int                     @id @default(autoincrement())
  name           String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          CallSheetTemplateItem[]
  productions    Production[]
  organizationId Int                     @default(dbgenerated("missing_organization_id()"))
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CallSheetTemplateItem {
  id             String                      @id @default(cuid())
  templateId     Int
  title          String
  note           String?
  durationSec    Int
  orderIndex     Int                         @default(0)
  isInVenue      Boolean                     @default(false)
  isInLivestream Boolean                     @default(true)
  isTimeAnchor   Boolean                     @default(false)
  anchorType     String?
  autoAdvance    Boolean                     @default(false)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  parentId       String?
  parent         CallSheetTemplateItem?      @relation("LinkedTemplateItems", fields: [parentId], references: [id])
  linkedItems    CallSheetTemplateItem[]     @relation("LinkedTemplateItems")
  template       CallSheetTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  positions      CallSheetTemplatePosition[]
  organizationId Int                         @default(dbgenerated("missing_organization_id()"))
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([parentId])
  @@index([organizationId])
}

model CallSheetTemplatePosition {
  templateItemId String
  positionId     Int
  position       Position              @relation(fields: [positionId], references: [id], onDelete: Cascade)
  item           CallSheetTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Cascade)
  organizationId Int                   @default(dbgenerated("missing_organization_id()"))
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([templateItemId, positionId])
  @@index([positionId])
  @@index([organizationId])
}

/// People marked as present for a production
model ProductionPerson {
  id             Int          @id @default(autoincrement())
  productionId   Int
  personId       Int
  createdAt      DateTime     @default(now())
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  production     Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionId, personId])
  @@index([productionId])
  @@index([personId])
  @@index([organizationId])
}

model ProductionPersonPosition {
  id             Int          @id @default(autoincrement())
  productionId   Int
  personId       Int
  positionId     Int
  createdAt      DateTime     @default(now())
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  position       Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  production     Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionId, personId, positionId])
  @@index([productionId])
  @@index([personId])
  @@index([positionId])
  @@index([organizationId])
}

model ProductionSegment {
  id             Int                     @id @default(autoincrement())
  productionId   Int
  naam           String
  volgorde       Int
  duurInMinuten  Int
  isTimeAnchor   Boolean                 @default(false)
  callSheetItems CallSheetItem[]
  production     Production              @relation(fields: [productionId], references: [id], onDelete: Cascade)
  bezetting      SegmentRoleAssignment[]
  organizationId Int                     @default(dbgenerated("missing_organization_id()"))
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionId, volgorde])
  @@index([productionId])
  @@index([organizationId])
}

model SegmentTemplate {
  id             Int                   @id @default(autoincrement())
  name           String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  isDefault      Boolean               @default(false)
  items          SegmentTemplateItem[]
  organizationId Int                   @default(dbgenerated("missing_organization_id()"))
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model SegmentTemplateItem {
  id             Int             @id @default(autoincrement())
  templateId     Int
  naam           String
  volgorde       Int
  duurInMinuten  Int
  isTimeAnchor   Boolean         @default(false)
  template       SegmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  organizationId Int             @default(dbgenerated("missing_organization_id()"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([templateId, volgorde])
  @@index([templateId])
  @@index([organizationId])
}

model SegmentDefaultPosition {
  id             Int          @id @default(autoincrement())
  segmentName    String
  positionId     Int
  order          Int
  position       Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, segmentName, order])
  @@index([segmentName])
  @@index([positionId])
  @@index([organizationId])
}

model SegmentRoleAssignment {
  id                  Int               @id @default(autoincrement())
  productionSegmentId Int
  personId            Int
  createdAt           DateTime          @default(now())
  positionId          Int
  person              Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  position            Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  productionSegment   ProductionSegment @relation(fields: [productionSegmentId], references: [id], onDelete: Cascade)
  organizationId      Int               @default(dbgenerated("missing_organization_id()"))
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionSegmentId, positionId, personId])
  @@index([productionSegmentId])
  @@index([personId])
  @@index([positionId])
  @@index([organizationId])
}

model Club {
  id            Int            @id @default(autoincrement())
  name          String
  shortName     String
  slug          String         @unique
  logoUrl       String?
  createdAt     DateTime       @default(now())
  players       Player[]
  organizations Organization[]
}

model Player {
  id                Int                @id @default(autoincrement())
  clubId            Int
  name              String
  shirtNo           Int?
  gender            Gender?
  photoUrl          String?
  externalId        String?
  createdAt         DateTime           @default(now())
  function          String?
  personType        String?
  seasonId          Int
  season            Season             @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  interviewSubjects InterviewSubject[]
  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([seasonId, externalId])
  @@index([clubId])
  @@index([seasonId, clubId])
  @@index([name])
}

model TitleDefinition {
  id                Int                @id @default(autoincrement())
  productionId      Int?
  name              String
  order             Int                @default(1)
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  interviewSubjects InterviewSubject[]
  production        Production?        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  parts             TitlePart[]
  organizationId    Int                @default(dbgenerated("missing_organization_id()"))
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([productionId, order])
  @@index([organizationId])
}

model TitlePart {
  id                Int             @id @default(autoincrement())
  titleDefinitionId Int
  sourceType        TitleSourceType
  teamSide          TeamSide        @default(NONE)
  limit             Int?
  filters           Json?
  customFunction    String?
  customName        String?
  definition        TitleDefinition @relation(fields: [titleDefinitionId], references: [id], onDelete: Cascade)
  organizationId    Int             @default(dbgenerated("missing_organization_id()"))
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([titleDefinitionId])
  @@index([organizationId])
}

model InterviewSubject {
  id                Int              @id @default(autoincrement())
  productionId      Int
  side              TeamSide
  role              InterviewRole
  playerId          Int
  titleDefinitionId Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  player            Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  production        Production       @relation(fields: [productionId], references: [id], onDelete: Cascade)
  titleDefinition   TitleDefinition? @relation(fields: [titleDefinitionId], references: [id])
  organizationId    Int              @default(dbgenerated("missing_organization_id()"))
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionId, side, role, titleDefinitionId])
  @@index([productionId])
  @@index([playerId])
  @@index([titleDefinitionId])
  @@index([organizationId])
}

model PlayerImage {
  id        Int      @id @default(autoincrement())
  subject   String
  filename  String
  createdAt DateTime @default(now())

  @@index([subject])
}

model CallSheet {
  id             Int             @id @default(autoincrement())
  productionId   Int
  name           String
  color          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  production     Production      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  items          CallSheetItem[]
  organizationId Int             @default(dbgenerated("missing_organization_id()"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([productionId, name])
  @@index([productionId])
  @@index([organizationId])
}

model CallSheetItem {
  id                  String                  @id
  callSheetId         Int
  productionSegmentId Int?
  cue                 String
  title               String
  note                String?
  color               String?
  timeStart           DateTime?
  timeEnd             DateTime?
  durationSec         Int
  orderIndex          Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  isInVenue           Boolean                 @default(false)
  anchorType          String?
  isTimeAnchor        Boolean                 @default(false)
  autoAdvance         Boolean                 @default(false)
  isInLivestream      Boolean                 @default(true)
  parentId            String?
  callSheet           CallSheet               @relation(fields: [callSheetId], references: [id], onDelete: Cascade)
  parent              CallSheetItem?          @relation("LinkedItems", fields: [parentId], references: [id])
  linkedItems         CallSheetItem[]         @relation("LinkedItems")
  productionSegment   ProductionSegment?      @relation(fields: [productionSegmentId], references: [id], onDelete: Cascade)
  positions           CallSheetItemPosition[]
  organizationId      Int                     @default(dbgenerated("missing_organization_id()"))
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([callSheetId])
  @@index([productionSegmentId])
  @@index([parentId])
  @@index([organizationId])
}

model CallSheetItemPosition {
  callSheetItemId String
  positionId      Int
  createdAt       DateTime      @default(now())
  item            CallSheetItem @relation(fields: [callSheetItemId], references: [id], onDelete: Cascade)
  position        Position      @relation(fields: [positionId], references: [id], onDelete: Cascade)
  organizationId  Int           @default(dbgenerated("missing_organization_id()"))
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([callSheetItemId, positionId])
  @@index([positionId])
  @@index([organizationId])
}

model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionReport {
  id                 Int          @id @default(autoincrement())
  productionId       Int          @unique
  matchSponsor       String?
  ballSponsor        String?
  interviewRationale String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  remarks            String?
  production         Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)
  organizationId     Int          @default(dbgenerated("missing_organization_id()"))
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([organizationId])
}

model ProductionEvent {
  id               String                    @id @default(cuid())
  productionId     Int
  metadata         Json?
  createdAt        DateTime                  @default(now())
  actualStartTime  DateTime?
  order            Int
  status           EventStatus               @default(WAITING)
  title            String
  triggerSource    TriggerSource             @default(MANUAL)
  vMixInputName    String?
  durationSec      Int?
  note             String?
  plannedEndTime   DateTime?
  plannedStartTime DateTime?
  anchorType       String?
  autoAdvance      Boolean                   @default(false)
  callSheetItemId  String?                   @unique
  isInLivestream   Boolean                   @default(true)
  isInVenue        Boolean                   @default(false)
  isTimeAnchor     Boolean                   @default(false)
  parentId         String?
  parent           ProductionEvent?          @relation("LinkedEvents", fields: [parentId], references: [id])
  linkedItems      ProductionEvent[]         @relation("LinkedEvents")
  production       Production                @relation(fields: [productionId], references: [id], onDelete: Cascade)
  positions        ProductionEventPosition[]
  organizationId   Int                       @default(dbgenerated("missing_organization_id()"))
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([productionId, createdAt])
  @@index([parentId])
  @@index([organizationId])
}

model ProductionEventPosition {
  eventId        String
  positionId     Int
  event          ProductionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position       Position        @relation(fields: [positionId], references: [id], onDelete: Cascade)
  organizationId Int             @default(dbgenerated("missing_organization_id()"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([eventId, positionId])
  @@index([organizationId])
}

enum SponsorType {
  premium
  goud
  zilver
  brons
  event
}

enum Gender {
  male
  female
}

enum SkillType {
  crew
  entertainment
}

enum PositionCategory {
  GENERAL
  TECHNICAL
  ENTERTAINMENT
}

enum TitleSourceType {
  COMMENTARY
  PRESENTATION
  PRESENTATION_AND_ANALIST
  TEAM_PLAYER
  TEAM_COACH
  FREE_TEXT
}

enum TeamSide {
  HOME
  AWAY
  NONE
}

enum InterviewRole {
  PLAYER
  COACH
}

enum EventStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum TriggerSource {
  VMIX
  MANUAL
  AUTO
}

/// A club or federation that runs its own productions. Every tenant table carries organizationId;
/// the Prisma extension in services/prisma.ts scopes all queries to the organization in the context.
model Organization {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  /// Uploaded logo (file name under storage/organizations/); falls back to the linked club's logo
  logoUrl   String?
  /// Optional link to the shared Club (logo fallback, own club)
  clubId    Int?
  /// Only active organizations are offered on the start screen
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  sponsors                   Sponsor[]
  matchSchedules             MatchSchedule[]
  skills                     Skill[]
  positions                  Position[]
  positionLinks              PositionLink[]
  persons                    Person[]
  personSkills               PersonSkill[]
  matchRoleAssignments       MatchRoleAssignment[]
  productions                Production[]
  callSheetTemplates         CallSheetTemplate[]
  callSheetTemplateItems     CallSheetTemplateItem[]
  callSheetTemplatePositions CallSheetTemplatePosition[]
  productionPersons          ProductionPerson[]
  productionPersonPositions  ProductionPersonPosition[]
  productionSegments         ProductionSegment[]
  segmentTemplates           SegmentTemplate[]
  segmentTemplateItems       SegmentTemplateItem[]
  segmentDefaultPositions    SegmentDefaultPosition[]
  segmentRoleAssignments     SegmentRoleAssignment[]
  titleDefinitions           TitleDefinition[]
  titleParts                 TitlePart[]
  interviewSubjects          InterviewSubject[]
  callSheets                 CallSheet[]
  callSheetItems             CallSheetItem[]
  callSheetItemPositions     CallSheetItemPosition[]
  productionReports          ProductionReport[]
  productionEvents           ProductionEvent[]
  productionEventPositions   ProductionEventPosition[]
  settings                   OrganizationSetting[]
  matchSource                MatchSource?
  apiKeys                    OrganizationApiKey[]
}

/// Settings of one organization (vMix, sponsor filters, scoreboard, club config). Installation-wide
/// keys (activeSeasonId) stay in Setting.
model OrganizationSetting {
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

/// Where an organization imports its match schedule from. apiToken is never returned by the API.
model MatchSource {
  id             Int          @id @default(autoincrement())
  organizationId Int          @unique @default(dbgenerated("missing_organization_id()"))
  provider       String       @default("vrijwilligers")
  baseUrl        String
  apiToken       String?
  isEnabled      Boolean      @default(true)
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// API key for feeds (vMix data sources, devices) of one organization; only the SHA-256 hash is stored.
model OrganizationApiKey {
  id             Int          @id @default(autoincrement())
  organizationId Int          @default(dbgenerated("missing_organization_id()"))
  name           String
  keyHash        String       @unique
  prefix         String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
