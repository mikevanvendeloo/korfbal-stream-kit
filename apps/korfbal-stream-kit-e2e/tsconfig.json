{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": ["es2022", "dom"],
    "rootDir": "../..",
    "outDir": "out-tsc/playwright",
    "sourceMap": false
  },
  "include": [
    "../korfbal-stream-api/test-scenarios.ts",
    "**/*.ts",
    "**/*.js",
    "playwright.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.js",
    "src/**/*.test.ts",
    "src/**/*.test.js",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ],
  "references": [
    {
      "path": "../korfbal-stream-api"
    }
  ]
}
