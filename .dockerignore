# Exclude files from Docker build context to speed up builds
node_modules
npm-debug.log
Dockerfile*
**/.git
.git
.gitignore

# Nx / build artifacts
dist
/dist
/tmp
/tmp/**
.nx
.github
.vscode
.idea
*.log
.env
.env.local
tmp
coverage

# Tests and coverage
coverage
**/*.spec.ts
**/*.spec.tsx
**/*.test.ts
**/*.test.tsx

# Local data and uploads
/uploads
/data
/data/**

# IDE/editor files
.vscode
.idea
*.iml

# OS files
.DS_Store
Thumbs.db

# Lokale secrets/env-bestanden nooit in de build-context (de API-build kopieert anders
# apps/korfbal-stream-api/.env als asset mee de image in)
**/.env
**/.env.local
**/.env.*.local
**/secrets.env
**/secrets.*.env
